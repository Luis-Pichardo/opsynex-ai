# Opsynex AI — variables de entorno de ejemplo.
# Copia este archivo a .env (no se sube al repositorio) y ajusta los valores.
# Las claves con "__" siguen la convención de ASP.NET Core (Seccion__Clave).

# --- Base de datos (SQL Server 2022) ---
MSSQL_SA_PASSWORD=Opsynex_Dev_2026!
ConnectionStrings__Default=Server=localhost,1433;Database=Opsynex;User Id=sa;Password=Opsynex_Dev_2026!;TrustServerCertificate=True
# Proveedor: SqlServer (normal) o Sqlite (solo pruebas sin Docker).
Database__Provider=SqlServer
# Aplica las migraciones pendientes al arrancar el API (true en Development).
Database__MigrateOnStartup=true
# Pruebas de integración: vacío = SQL Server con Testcontainers si hay Docker, si no SQLite;
# "sqlserver" exige Docker; "sqlite" fuerza SQLite.
OPSYNEX_TEST_DB=
# Pruebas de homologación de punta a punta con el servicio de IA real: por defecto se arranca con
# ai-service/.venv; OPSYNEX_AI_PYTHON indica otro intérprete y OPSYNEX_REQUIRE_AI=true las exige.
OPSYNEX_AI_PYTHON=
OPSYNEX_REQUIRE_AI=

# --- Autenticación JWT. Mínimo 32 bytes; en producción usa un secreto aleatorio (openssl rand -base64 48). ---
Jwt__Secret=cambia-este-secreto-de-desarrollo-de-al-menos-32-caracteres
Jwt__ExpireMinutes=60
# Bloqueo temporal del login
Auth__MaxFailedAttempts=5
Auth__LockoutMinutes=15

# --- Primer Admin (no hay auto-registro). Se crea al arrancar si no existe. ---
# Mínimo 8 caracteres con letras y números. Vacíos = no se crea.
Seed__AdminEmail=admin@opsynex.local
Seed__AdminPassword=CambiaEsto2026

# --- CORS: orígenes del frontend permitidos, separados por comas ---
Cors__Origins=http://localhost:5173

# --- Servicio de IA (Python) ---
AiService__Enabled=true
AiService__BaseUrl=http://localhost:8001
# Tiempo máximo de una llamada (con reintentos) y reintentos ante errores transitorios.
AiService__TimeoutSeconds=10
AiService__MaxRetries=2
# Clave compartida API <-> servicio de IA (cabecera X-Internal-Api-Key).
# En el servicio de IA se lee como AI_SERVICE_API_KEY (docker-compose la copia de aquí).
AiService__ApiKey=dev-internal-key

# --- Claude (Anthropic), solo en el servicio de IA ---
# Sin clave la plataforma funciona igual con las recomendaciones base (la UI lo indica).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento (low, medium, high, xhigh, max). Opus 5.5 usa "medium" por defecto.
ANTHROPIC_EFFORT=medium
# Respaldo del servidor si el modelo rechaza la petición: "default" o "none" (modelos sin fallbacks, p. ej. Haiku).
ANTHROPIC_FALLBACKS=default
LLM_TIMEOUT_SECONDS=90

# --- IA en el API (.NET): recomendaciones, resumen ejecutivo y anomalías ---
# Ai__Enabled=false desactiva todo el paso de IA (se usan las recomendaciones base).
Ai__Enabled=true
# Background (producción) o Inline (pruebas: espera a la IA dentro de la petición).
Ai__Mode=Background
Ai__MaxRecommendations=10
Ai__TimeoutSeconds=180

# --- Frontend (Vite) ---
# Desarrollo local (dotnet run usa el puerto 5080):
VITE_API_URL=http://localhost:5080
# Imagen Docker del frontend (el API del compose escucha en 8080):
VITE_API_URL_DOCKER=http://localhost:8080

# --- Carga de archivos ---
Upload__MaxMb=20

# Límites de peticiones (etapa 13): logins por IP y cargas por usuario, por minuto.
RateLimiting__Enabled=true
RateLimiting__LoginPermitLimit=10
RateLimiting__UploadPermitLimit=20
# Detrás de un balanceador: true solo si el API no es accesible directamente.
ReverseProxy__TrustAll=false
# Contraseña de los usuarios del comando seed-demo (por defecto Demo2026!).
Demo__Password=
