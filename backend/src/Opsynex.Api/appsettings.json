    "Currencies": {
      "DOP": {
        "RevenuePerEmployee": {
          "Worst": 1500000,
          "Best": 15000000
        }
      },
      "USD": {
        "RevenuePerEmployee": {
          "Worst": 30000,
          "Best": 300000
        }
      }
    }
  },
  "DiagnosisRules": {
    "Rules": {
      "EBITDA_DECLINE": {
        "Enabled": true,
        "Low": 0.5,
        "Medium": 2,
        "High": 5
      },
      "GROSS_MARGIN_DECLINE": {
        "Enabled": true,
        "Low": 0.5,
        "Medium": 2,
        "High": 5
      },
      "COST_GROWTH_FLAT_REVENUE": {
        "Enabled": true,
        "Low": 2,
        "Medium": 5,
        "High": 10,
        "Reference": {
          "Default": 2
        }
      },
      "OVERHEAD_OUTPACES_REVENUE": {
        "Enabled": true,
        "Low": 0.01,
        "Medium": 5,
        "High": 10
      },
      "LABOR_COST_OUTPACES_REVENUE": {
        "Enabled": true,
        "Low": 0.01,
        "Medium": 5,
        "High": 10
      },
      "PRODUCTIVITY_DECLINE": {
        "Enabled": true,
        "Low": 2,
        "Medium": 7,
        "High": 15
      },
      "REVENUE_DECLINE": {
        "Enabled": true,
        "Low": 2,
        "Medium": 7,
        "High": 15
      },
      "ENERGY_COST_SPIKE": {
        "Enabled": true,
        "Low": 10,
        "Medium": 15,
        "High": 25
      },
      "LOW_EBITDA_MARGIN": {
        "Enabled": true,
        "Low": 0.01,
        "Medium": 2,
        "High": 5,
        "Reference": {
          "Manufacturing": 0.1,
          "Services": 0.12
        }
      },
      "HIGH_OPEX_RATIO": {
        "Enabled": true,
        "Low": 0.01,
        "Medium": 5,
        "High": 10,
        "Reference": {
          "Manufacturing": 0.25,
          "Services": 0.4
        }
      },
      "HIGH_MATERIAL_LOSS": {
        "Enabled": true,
        "Low": 0.01,
        "Medium": 2,
        "High": 5,
        "Reference": {
          "Default": 0.03
        }
      },
      "LOW_LIQUIDITY": {
        "Enabled": true,
        "Low": 0.0001,
        "Medium": 0.1,
        "High": 0.3,
        "Reference": {
          "Default": 1.0
        }
      },
      "HIGH_LEVERAGE": {
        "Enabled": true,
        "Low": 0.0001,
        "Medium": 1,
        "High": 2,
        "Reference": {
          "Default": 3.0
        }
      }
    }
  },
  "Score": {
    "Weights": {
      "Profitability": 0.3,
      "CostEfficiency": 0.25,
      "Productivity": 0.25,
      "FinancialStability": 0.2
    },
    "ProductivityTrendWeight": 0.3,
    "ProductivityTrendRangePercent": 10,
    "MarginVolatilityWorstPp": 5,
    "MarginVolatilityWindowYears": 3
  },
  "Ai": {
    "Enabled": true,
    "Mode": "Background",
    "RecommendationSeverities": [
      "High",
      "Medium"
    ],
    "MaxRecommendations": 10,
    "DetectAnomalies": true,
    "Country": "República Dominicana",
    "TimeoutSeconds": 180
  }
}
