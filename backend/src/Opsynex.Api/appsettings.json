{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Secret": "",
    "ExpireMinutes": 60,
    "Issuer": "opsynex-api",
    "Audience": "opsynex-web"
  },
  "Cors": {
    "Origins": []
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "ApiKey": "",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "MaxRetries": 2
  },
  "Upload": {
    "MaxMb": 20
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Administrador"
  },
