{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Secret": "",
    "ExpireMinutes": 60,
    "Issuer": "opsynex-api",
    "Audience": "opsynex-web"
  },
  "Cors": {
    "Origins": []
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "ApiKey": "",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "MaxRetries": 2
  },
  "Upload": {
    "MaxMb": 20
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "UploadPermitLimit": 20,
    "UploadWindowSeconds": 60
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "TrustAll": false
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Administrador"
  },
  "Benchmarks": {
    "StableThresholdPercent": 1,
    "Industries": {
      "Manufacturing": {
        "EbitdaMargin": {
          "Worst": 0,
          "Best": 0.2
        },
        "GrossMargin": {
          "Worst": 0.1,
          "Best": 0.4
        },
        "NetMargin": {
          "Worst": 0,
          "Best": 0.12
        },
        "CostEfficiency": {
          "Worst": 1.0,
          "Best": 0.75
        },
        "OperatingCostRatio": {
          "Worst": 0.35,
          "Best": 0.1
        },
        "OverheadRatio": {
          "Worst": 0.2,
          "Best": 0.03
        },
        "EnergyCostRatio": {
          "Worst": 0.12,
          "Best": 0.02
        },
        "LaborCostRatio": {
          "Worst": 0.4,
          "Best": 0.1
        },
        "InventoryDays": {
          "Worst": 150,
          "Best": 30
        },
        "CurrentRatio": {
          "Worst": 0.8,
          "Best": 2.0
        },
        "DebtToEquity": {
          "Worst": 2.5,
          "Best": 0.3
        },
        "DaysSalesOutstanding": {
          "Worst": 120,
          "Best": 30
        }
      },
      "Services": {
        "EbitdaMargin": {
          "Worst": 0,
          "Best": 0.25
        },
        "GrossMargin": {
          "Worst": 0.2,
          "Best": 0.6
        },
        "NetMargin": {
          "Worst": 0,
          "Best": 0.15
        },
        "CostEfficiency": {
          "Worst": 1.0,
          "Best": 0.7
        },
        "OperatingCostRatio": {
          "Worst": 0.5,
          "Best": 0.15
        },
        "OverheadRatio": {
          "Worst": 0.25,
          "Best": 0.05
        },
        "EnergyCostRatio": {
          "Worst": 0.06,
          "Best": 0.005
        },
        "LaborCostRatio": {
          "Worst": 0.6,
          "Best": 0.25
        },
        "InventoryDays": {
          "Worst": 60,
